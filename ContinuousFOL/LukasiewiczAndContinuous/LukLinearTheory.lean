Paper pin: algebraic half of Fact 4.1 (Chang 1958). If `Γ ⊬ φ`, then `Γ` extends
to a premise set `Δ ⊬ φ` that is *linear*: for all `α, β`, `Δ ⊢ α ∸ β` or
`Δ ⊢ β ∸ α`. Its Lindenbaum algebra is then an MV-chain. This is Chang's
subdirect-representation step (Mundici, *Introducing MV-algebras*, Prop. 1.19),
carried out on premise sets, where the ideal generated by a new element is given
by the weak deduction theorem.
-/
module

public import ContinuousFOL.LukasiewiczAndContinuous.LukLindenbaum
public import ContinuousFOL.LukasiewiczAndContinuous.MVBasic
public import Mathlib.Order.Zorn

@[expose] public section

noncomputable section
open Classical

namespace ContinuousFOL

open LukPropForm MVAlgebra

namespace LukLind

variable {ι : Type*} {Γ : Set (LukPropForm ι)} [Inhabited (LukPropForm ι)]

lemma mv_zero_eq_zero : (MVAlgebra.zero : LukLindT Γ) = (0 : LukLindT Γ) := rfl

lemma mk_iterSub (φ ψ : LukPropForm ι) (n : ℕ) :
    (mk (iterSub φ ψ n) : LukLindT Γ) = mk φ ⊖ nsm n (mk ψ) := by
  induction n with
  | zero =>
    simp only [iterSub, nsm]
    exact (msub_zero _).symm
  | succ n ih =>
    rw [iterSub, ← msub_mk, ih, nsm, msub_msub]

lemma mk_eq_zero_iff' (φ : LukPropForm ι) :
    (mk φ : LukLindT Γ) = (MVAlgebra.zero : LukLindT Γ) ↔ Provable Γ φ :=
  mk_eq_zero_iff φ

lemma le_mk_iff (α β : LukPropForm ι) :
    MVAlgebra.le (mk α : LukLindT Γ) (mk β) ↔ Provable Γ (α.tsub β) := by
  rw [le_iff_msub_eq_zero, msub_mk]
  exact mk_eq_zero_iff' _

end LukLind

namespace LukPropForm

variable {ι : Type*}

/-- A premise set is linear if any two formulae are comparable under it. -/
def IsLinear (Δ : Set (LukPropForm ι)) : Prop :=
  ∀ α β : LukPropForm ι, Provable Δ (α.tsub β) ∨ Provable Δ (β.tsub α)

lemma finset_subset_mem_of_chain {c : Set (Set (LukPropForm ι))}
    (hc : IsChain (· ⊆ ·) c) (hne : c.Nonempty) (F : Finset (LukPropForm ι))
    (hF : (↑F : Set (LukPropForm ι)) ⊆ ⋃₀ c) : ∃ d ∈ c, (↑F : Set (LukPropForm ι)) ⊆ d := by
  induction F using Finset.induction_on with
  | empty =>
    obtain ⟨d, hd⟩ := hne
    exact ⟨d, hd, by simp⟩
  | insert a F _ ih =>
    rw [Finset.coe_insert, Set.insert_subset_iff] at hF
    obtain ⟨d₁, hd₁, ha⟩ := Set.mem_sUnion.mp hF.1
    obtain ⟨d₂, hd₂, hF₂⟩ := ih hF.2
    rcases hc.total hd₁ hd₂ with h | h
    · exact ⟨d₂, hd₂, by
        rw [Finset.coe_insert, Set.insert_subset_iff]; exact ⟨h ha, hF₂⟩⟩
    · exact ⟨d₁, hd₁, by
        rw [Finset.coe_insert, Set.insert_subset_iff]; exact ⟨ha, hF₂.trans h⟩⟩

/-- **Linear extension.** If `Γ ⊬ φ` then some linear `Δ ⊇ Γ` still has `Δ ⊬ φ`. -/
theorem exists_linear_extension (Γ : Set (LukPropForm ι)) (φ : LukPropForm ι)
    (hφ : ¬ Provable Γ φ) :
    ∃ Δ : Set (LukPropForm ι), Γ ⊆ Δ ∧ ¬ Provable Δ φ ∧ IsLinear Δ := by
  let S : Set (Set (LukPropForm ι)) := {Δ | Γ ⊆ Δ ∧ ¬ Provable Δ φ}
  have hS : ∀ c ⊆ S, IsChain (· ⊆ ·) c → c.Nonempty → ∃ ub ∈ S, ∀ s ∈ c, s ⊆ ub := by
    intro c hcS hc hne
    refine ⟨⋃₀ c, ⟨?_, ?_⟩, fun s hs => Set.subset_sUnion_of_mem hs⟩
    · obtain ⟨d, hd⟩ := hne
      exact (hcS hd).1.trans (Set.subset_sUnion_of_mem hd)
    · intro hp
      obtain ⟨F, hFsub, hF⟩ := compact hp
      obtain ⟨d, hd, hFd⟩ := finset_subset_mem_of_chain hc hne F hFsub
      exact (hcS hd).2 (mono hFd hF)
  obtain ⟨Δ, hΓΔ, hmax⟩ := zorn_subset_nonempty S hS Γ ⟨subset_rfl, hφ⟩
  refine ⟨Δ, hΓΔ, hmax.prop.2, ?_⟩
  intro α β
  by_contra hcon
  push Not at hcon
  have : Inhabited (LukPropForm ι) := ⟨φ⟩
  -- Adding either comparison yields `φ`.
  have hadd : ∀ θ, ¬ Provable Δ θ → Provable (Δ ∪ {θ}) φ := by
    intro θ hθ
    by_contra hnot
    have hmem : Δ ∪ {θ} ∈ S := ⟨hΓΔ.trans Set.subset_union_left, hnot⟩
    have hsub := hmax.2 hmem Set.subset_union_left
    exact hθ (.hyp (hsub (Set.mem_union_right _ rfl)))
  obtain ⟨n, hn⟩ := (deduction_theorem Δ φ (α.tsub β)).mp (hadd _ hcon.1)
  obtain ⟨m, hm⟩ := (deduction_theorem Δ φ (β.tsub α)).mp (hadd _ hcon.2)
  -- Work in the Lindenbaum algebra of `Δ`.
  let x : LukLindT Δ := LukLind.mk φ
  let p : LukLindT Δ := LukLind.mk (α.tsub β)
  let q : LukLindT Δ := LukLind.mk (β.tsub α)
  have hxp : le x (nsm (n + m) p) := by
    have h0 : (LukLind.mk (iterSub φ (α.tsub β) n) : LukLindT Δ) = MVAlgebra.zero :=
      (LukLind.mk_eq_zero_iff' _).mpr hn
    rw [LukLind.mk_iterSub] at h0
    exact le_trans ((le_iff_msub_eq_zero _ _).mpr h0) (nsm_mono _ (Nat.le_add_right n m))
  have hxq : le x (nsm (n + m) q) := by
    have h0 : (LukLind.mk (iterSub φ (β.tsub α) m) : LukLindT Δ) = MVAlgebra.zero :=
      (LukLind.mk_eq_zero_iff' _).mpr hm
    rw [LukLind.mk_iterSub] at h0
    exact le_trans ((le_iff_msub_eq_zero _ _).mpr h0) (nsm_mono _ (Nat.le_add_left m n))
  have hpq : meet p q = 0 := by
    have := meet_msub_msub (LukLind.mk α : LukLindT Δ) (LukLind.mk β)
    rwa [LukLind.msub_mk, LukLind.msub_mk] at this
  have hx0 : le x 0 := by
    have := le_meet hxp hxq
    rwa [meet_nsm_nsm hpq] at this
  exact hmax.prop.2 ((LukLind.mk_eq_zero_iff' φ).mp (le_zero_iff.mp hx0))

end LukPropForm

namespace LukLind

variable {ι : Type*} {Δ : Set (LukPropForm ι)} [Inhabited (LukPropForm ι)]

/-- The Lindenbaum algebra of a linear premise set is totally ordered. -/
lemma le_total_of_isLinear (hΔ : IsLinear Δ) (x y : LukLindT Δ) : le x y ∨ le y x := by
  induction x using ind with | h α => ?_
  induction y using ind with | h β => ?_
  rw [le_mk_iff, le_mk_iff]
  exact hΔ α β

end LukLind

end ContinuousFOL
